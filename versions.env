# Pinned upstream versions. Sourced by deploy/operators/install.sh and documented in README.
# Bump these together.
# haven-idp is the default identity engine; its image tag follows the Haven release.
# KEYCLOAK_OPERATOR_REF is LEGACY: only used when INSTALL_KEYCLOAK_OPERATOR=1 (deprecated engine,
# must match the Keycloak server version).

CNPG_VERSION=1.30.2
HAVEN_IDP_IMAGE_TAG=0.1.0
HAVEN_IDP_IMAGE=ghcr.io/zyvorai/haven-idp:${HAVEN_IDP_IMAGE_TAG}
# legacy (deprecated Keycloak engine)
KEYCLOAK_OPERATOR_REF=26.8.2
CERT_MANAGER_VERSION=v1.21.3
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:16.15
