# Multi-stage: React UI + Go haven-console (embedded SPA)
FROM node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS ui
WORKDIR /src
COPY ui/web/package.json ui/web/package-lock.json ./
RUN npm ci
COPY ui/web/ .
RUN npm run build

FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS gobuild
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/
COPY --from=ui /src/dist cmd/haven-console/dist/
RUN CGO_ENABLED=0 go build -o /out/haven-console ./cmd/haven-console

FROM gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
COPY --from=gobuild /out/haven-console /haven-console
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/haven-console"]
