# haven — thin CLI over the compose path and IdentityPlane CRs.
set -euo pipefail

usage() {
  cat <<EOF
haven — operate a Haven identity plane

  haven deploy -f plane.yaml
  haven status [name] [-n namespace]
  haven open   [name] [-n namespace]
  haven doctor [name] [-n namespace]
  haven backup [name] [-n namespace] [--now]
  haven admin  [name] [-n namespace] [--show-secret]
                                       how to read the admin password (value only with --show-secret)

Defaults: name=platform  namespace=identity
EOF
}

cmd="${1:-help}"
shift || true

NS="identity"
NAME="platform"
FILE=""
NOW=false
SHOW_SECRET=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--namespace) NS="$2"; shift 2 ;;
    -f|--file) FILE="$2"; shift 2 ;;
    --now) NOW=true; shift ;;
    --show-secret) SHOW_SECRET=true; shift ;;
    -h|--help) usage; exit 0 ;;
    -*)
      echo "unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      NAME="$1"
      shift
      ;;
  esac
done

# Native engine (haven-idp) names per internal/render/IDP_CONTRACT.md.
idp_secret() { echo "${NAME}-idp"; }
# issuer = <base URL>/realms/<first realm>; dev planes are HTTP, everything else HTTPS.
plane_issuer() {
  local host realm profile scheme=https
  host="$(kubectl get identityplane "$NAME" -n "$NS" -o jsonpath='{.spec.hostname}' 2>/dev/null || true)"
  realm="$(kubectl get identityplane "$NAME" -n "$NS" -o jsonpath='{.spec.bootstrap.firstRealm}' 2>/dev/null || true)"
  profile="$(kubectl get identityplane "$NAME" -n "$NS" -o jsonpath='{.spec.profile}' 2>/dev/null || true)"
  [[ "$profile" == dev ]] && scheme=http
  [[ -n "$host" ]] && echo "${scheme}://${host}/realms/${realm:-platform}"
  return 0
}

case "$cmd" in
  deploy)
    [[ -n "$FILE" ]] || { echo "usage: haven deploy -f plane.yaml" >&2; exit 2; }
    kubectl apply -f "$FILE"
    ;;
  status)
    echo "plane: ${NS}/${NAME}"
    if kubectl get identityplane "$NAME" -n "$NS" >/dev/null 2>&1; then
      kubectl get identityplane "$NAME" -n "$NS" -o wide
      echo
      echo "--- endpoints ---"
      kubectl get identityplane "$NAME" -n "$NS" \
        -o jsonpath='issuer={.status.endpoints.issuer}{"\n"}console={.status.endpoints.console}{"\n"}account={.status.endpoints.account}{"\n"}'
      echo
    else
      echo "(no IdentityPlane CR — compose path only)"
    fi
    echo "--- haven-idp ---"
    kubectl get deployment,service,pdb -n "$NS" -l app.kubernetes.io/name=haven-idp 2>/dev/null || echo "(none)"
    issuer="$(plane_issuer)"
    [[ -z "$issuer" ]] || echo "issuer: $issuer"
    echo
    echo "--- database ---"
    kubectl get cluster.postgresql.cnpg.io -n "$NS" 2>/dev/null || echo "(none)"
    echo
    echo "--- admin secret ---"
    echo "  kubectl -n $NS get secret $(idp_secret) -o jsonpath='{.data.admin-password}' | base64 -d; echo"
    echo "  (or: haven admin $NAME -n $NS)"
    ;;
  open)
    host="$(kubectl get identityplane "$NAME" -n "$NS" -o jsonpath='{.spec.hostname}' 2>/dev/null || true)"
    console="$(kubectl get identityplane "$NAME" -n "$NS" -o jsonpath='{.spec.consoleHostname}' 2>/dev/null || true)"
    if [[ -z "$host" ]]; then
      host="$(kubectl get ingress -n "$NS" -o jsonpath='{.items[0].spec.rules[0].host}' 2>/dev/null || true)"
    fi
    echo "issuer:   $(plane_issuer)"
    echo "account:  $(plane_issuer)/account"
    echo "console:  http://${console:-haven.127.0.0.1.nip.io}"
    ;;
  doctor)
    fail=0
    echo "== CRDs =="
    for c in \
      identityplanes.identity.haven.dev \
      clusters.postgresql.cnpg.io \
      certificates.cert-manager.io
    do
      if kubectl get crd "$c" >/dev/null 2>&1; then
        echo "  ok   $c"
      else
        echo "  MISS $c"
        fail=1
      fi
    done
    echo
    echo "== identity provider =="
    if kubectl get identityplane "$NAME" -n "$NS" >/dev/null 2>&1; then
      ready="$(kubectl get identityplane "$NAME" -n "$NS" -o jsonpath='{.status.conditions[?(@.type=="IdentityProviderReady")].status}' 2>/dev/null || true)"
      case "$ready" in
        True)
          echo "  ok   IdentityProviderReady=True"
          issuer="$(plane_issuer)"
          [[ -z "$issuer" ]] || echo "  issuer: $issuer"
          ;;
        False)
          echo "  FAIL IdentityProviderReady=False"
          fail=1
          ;;
        *)
          echo "  ??   IdentityProviderReady not reported yet (is the controller running?)"
          fail=1
          ;;
      esac
    else
      echo "  (no IdentityPlane CR in $NS)"
    fi
    echo
    echo "== operators =="
    kubectl -n cnpg-system get deploy cnpg-controller-manager -o wide 2>/dev/null || { echo "  MISS cnpg-controller-manager"; fail=1; }
    echo
    echo "== objects in $NS =="
    kubectl get identityplane,cluster.postgresql.cnpg.io,deployment,ingress,certificate,secret -n "$NS" 2>/dev/null || true
    echo
    echo "== pods in $NS =="
    kubectl get pods -n "$NS" -o wide 2>/dev/null || true
    echo
    if kubectl get cluster.postgresql.cnpg.io "${NAME}-db" -n "$NS" >/dev/null 2>&1; then
      phase="$(kubectl get cluster.postgresql.cnpg.io "${NAME}-db" -n "$NS" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
      echo "cnpg phase: ${phase:-unknown}"
    fi
    exit "$fail"
    ;;
  admin)
    secret="$(idp_secret)"
    echo "admin user: admin"
    echo "Read the admin password with:"
    echo "  kubectl -n $NS get secret $secret -o jsonpath='{.data.admin-password}' | base64 -d; echo"
    if $SHOW_SECRET; then
      echo -n "password: "
      kubectl -n "$NS" get secret "$secret" -o jsonpath='{.data.admin-password}' | base64 -d; echo
    else
      echo "(not printed; pass --show-secret to print it)"
    fi
    ;;
  backup)
    if $NOW; then
      ts="$(date +%Y%m%d%H%M%S)"
      cat <<EOF | kubectl apply -f -
apiVersion: postgresql.cnpg.io/v1
kind: Backup
metadata:
  name: ${NAME}-db-${ts}
  namespace: ${NS}
spec:
  cluster:
    name: ${NAME}-db
  method: volumeSnapshot
EOF
      echo "Requested volumeSnapshot backup ${NAME}-db-${ts}."
      echo "If your StorageClass has no snapshotter, configure an ObjectStore and use method: plugin instead."
    else
      kubectl get backup,scheduledbackup -n "$NS" 2>/dev/null || echo "(no backups)"
    fi
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
